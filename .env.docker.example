# Docker Compose Environment Variables
# Copy to .env and fill in your actual values

# Postgres (matches compose defaults — change if you want different creds)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mailops_db

# Backend Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_64_bytes
ENCRYPTION_KEY=4xW8Z3vK9uF2mP7qR1tY6bV5cN8jL0kH4gF2dS6aQ1w=

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER_TYPE=mock  # Use 'gemini' to enable real AI, 'mock' for offline dev

# Frontend
VITE_API_BASE_URL=http://localhost:8000