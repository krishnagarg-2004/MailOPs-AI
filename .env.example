# Application Configuration
APP_NAME=EnterpriseAIMailOPs_MIPRO
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security / Authentication (Template placeholders - NEVER commit actual secrets)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mailops_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailops_db

# AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
